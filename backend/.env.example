# ---------------------------------------------------------------------------
# SchemaWise AI - environment configuration
# Copy this file to `.env` (same folder) and fill in your values.
# ---------------------------------------------------------------------------

# Which AI backend to use: `groq` (cloud) or `ollama` (local, offline).
AI_PROVIDER=groq

# --- Groq (free tier) ------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Primary model, then automatic failover to the secondary model.
# Primary model: Qwen 3.8 27B (multimodal, 131K context, JSON mode).
GROQ_MODEL_PRIMARY=qwen/qwen3.8-27b
# Automatic failover. Qwen 3.8 27B is a Groq *preview* model, so keep a
# production model here - availability depends on your Groq account and provider limits.
GROQ_MODEL_SECONDARY=openai/gpt-oss-120b

# Optional tuning
# GROQ_REASONING_EFFORT=low
# AI_TIMEOUT=60
# AI_MAX_TOKENS=2048

# --- Ollama (only if AI_PROVIDER=ollama) ----------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# --- App -------------------------------------------------------------------
# The topic the quiz / exam features focus on by default.
ASSIGNED_TOPIC=DBMS (Database Management Systems)

# Optional: override the SQLite location (useful on hosts with an ephemeral disk).
# SCHEMAWISE_DB=/data/history.db
